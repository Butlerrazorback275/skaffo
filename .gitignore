# dependencies
node_modules/
engine/.venv/
.venv/

# build output
dist/
dist-electron/
release/

# NOTE: build/ is deliberately NOT ignored. It holds the icon set that
# electron-builder needs — icon.ico (Windows), icon.png (macOS) and
# icons/ (Linux). They are generated from build/icon.svg by
# `npm run build:icon`, but committing them means a fresh clone can build
# an installer without a working headless Chromium. 1.2 MB total.

# python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local data — never commit someone's projects or database
*.db
*.db-wal
*.db-shm
*.sqlite3

# environment / secrets
.env
.env.local
.env.*.local

# editor & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# v1.0 build output
release/
engine/dist/
engine/build/
engine/*.spec
