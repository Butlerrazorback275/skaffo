import { useState } from 'react';
import DataTable from '../components/DataTable';
import { useApi } from '../hooks/useApi';
import { api } from '../lib/api';
import type { @@ e.pascal @@ } from '../lib/types';

const columns = [
<% for c in e.list_columns %>
  { key: '@@ c.name @@' as const, label: '@@ c.name | replace("_", " ") | title @@' },
<% endfor %>
];

export default function @@ e.pascal_plural @@() {
  const [page, setPage] = useState(1);
  const [q, setQ] = useState('');
  const { data, loading, error, reload } = useApi(
    () => api.@@ e.plural @@.list({ page, size: 20, q: q || undefined }),
    [page, q],
  );

  const remove = async (row: @@ e.pascal @@) => {
<% if e.pk %>
    if (!confirm('Delete this @@ e.singular @@?')) return;
    await api.@@ e.plural @@.remove(row.@@ e.pk.name @@ as string | number);
    reload();
<% endif %>
  };

  return (
    <div>
      <div className="mb-5 flex items-center gap-3">
        <div>
          <h1 className="text-2xl font-semibold">@@ e.label @@</h1>
          <p className="text-sm text-slate-500">
            {data ? `${data.total} records` : '\u00a0'}
          </p>
        </div>
        <input
          value={q}
          onChange={(ev) => { setPage(1); setQ(ev.target.value); }}
          placeholder="Search…"
          className="ml-auto w-64 rounded-md border border-slate-300 px-3 py-2 text-sm outline-none focus:border-slate-500"
        />
      </div>

      {loading && <p className="py-8 text-center text-sm text-slate-400">Loading…</p>}

      {error && (
        <div className="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          {error}
        </div>
      )}

      {data && !loading && (
        <>
          <DataTable columns={columns} rows={data.items as never[]} onDelete={remove as never} />

          {data.pages > 1 && (
            <div className="mt-4 flex items-center justify-center gap-2">
              <button
                disabled={page <= 1}
                onClick={() => setPage((p) => p - 1)}
                className="rounded-md border border-slate-300 px-3 py-1.5 text-sm disabled:opacity-40"
              >
                Previous
              </button>
              <span className="text-sm text-slate-500">
                Page {data.page} of {data.pages}
              </span>
              <button
                disabled={page >= data.pages}
                onClick={() => setPage((p) => p + 1)}
                className="rounded-md border border-slate-300 px-3 py-1.5 text-sm disabled:opacity-40"
              >
                Next
              </button>
            </div>
          )}
        </>
      )}
    </div>
  );
}
