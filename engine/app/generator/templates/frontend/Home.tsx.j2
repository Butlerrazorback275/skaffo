import { Link } from 'react-router-dom';
import { useApi } from '../hooks/useApi';
import { api } from '../lib/api';

export default function Home() {
  const health = useApi(() => api.health(), []);

  return (
    <div>
      <h1 className="text-2xl font-semibold">@@ name | jsx_text @@</h1>
      <p className="mt-1 text-slate-500">
        Generated by Skaffo — FastAPI + React + SQLite.
      </p>

      <div className="mt-4 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm">
        <span
          className={`h-2 w-2 rounded-full ${
            health.loading ? 'bg-amber-400' : health.error ? 'bg-red-500' : 'bg-emerald-500'
          }`}
        />
        {health.loading ? 'Checking API…' : health.error ? `API offline — ${health.error}` : 'API online'}
      </div>

<% if has_entities %>
      <div className="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
<% for e in entities %>
        <Link
          to="/@@ e.plural @@"
          className="rounded-lg border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm"
        >
          <p className="font-medium">@@ e.label @@</p>
          <p className="mt-1 text-sm text-slate-500">
            @@ e.columns | length @@ fields · /api/@@ e.plural @@
          </p>
        </Link>
<% endfor %>
      </div>
<% else %>
      <div className="mt-8 rounded-lg border border-dashed border-slate-300 p-8 text-center text-slate-500">
        <p>No tables in your schema yet.</p>
        <p className="mt-1 text-sm">
          Add tables in Skaffo&apos;s Database Designer, then regenerate.
        </p>
      </div>
<% endif %>
    </div>
  );
}
