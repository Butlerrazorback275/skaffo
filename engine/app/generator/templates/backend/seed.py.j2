class _Ref:
    """A placeholder for 'the nth primary key of <table>', resolved later."""

    __slots__ = ("table", "index")

    def __init__(self, table: str, index: int) -> None:
        self.table = table
        self.index = index

    def __repr__(self) -> str:  # pragma: no cover - debugging aid
        return f"_Ref({self.table!r}, {self.index})"


def _ref(table: str, index: int) -> _Ref:
    return _Ref(table, index)


