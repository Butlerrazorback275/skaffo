def _count(session, model) -> int:
    return session.scalar(select(func.count()).select_from(model)) or 0


def _resolve(row: dict, known: dict[str, list]) -> dict | None:
    """Swap every _Ref for a real primary key. None if a parent is missing."""
    out = {}
    for key, value in row.items():
        if isinstance(value, _Ref):
            pool = known.get(value.table) or []
            if not pool:
                return None
            out[key] = pool[value.index % len(pool)]
        else:
            out[key] = value
    return out


def seed(reset: bool = False, count: int | None = None) -> int:
    """Insert sample rows. Returns the number written."""
    Base.metadata.create_all(bind=engine)
    session = SessionLocal()
    written = 0
    known: dict[str, list] = {}

    try:
        if reset:
            # Children first so foreign keys never block the delete.
            for table_name, model, _rows, _pk in reversed(SEED_PLAN):
                deleted = session.query(model).delete()
                if deleted:
                    print(f"  clear {table_name:<24} -{deleted} row(s)")
            session.commit()

        for table_name, model, rows, pk_attr in SEED_PLAN:
            existing = _count(session, model)
            if existing:
                print(f"  skip  {table_name:<24} already has {existing} row(s)")
                # Still record the ids so children can point at real parents.
                known[table_name] = [
                    getattr(o, pk_attr) for o in session.query(model).limit(200)
                ]
                continue

            batch = rows if count is None else rows[:count]
            objects = []
            for row in batch:
                resolved = _resolve(row, known)
                if resolved is None:
                    continue          # parent table was empty; skip the child
                objects.append(model(**resolved))

            if not objects:
                print(f"  skip  {table_name:<24} no parent rows to reference")
                known[table_name] = []
                continue

            session.add_all(objects)
            session.flush()           # primary keys exist from here on
            known[table_name] = [getattr(o, pk_attr) for o in objects]
            written += len(objects)
            print(f"  seed  {table_name:<24} +{len(objects)} row(s)")

        session.commit()
    except Exception:
        session.rollback()
        raise
    finally:
        session.close()

    return written


